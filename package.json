{
  "name": "mindoodb-jvm-bridge",
  "version": "0.0.1",
  "private": true,
  "description": "Headless Node sidecar that exposes a per-user MindooDB environment to a JVM/Kotlin client over a loopback WebSocket bridge.",
  "license": "Apache-2.0",
  "author": "Mindoo GmbH",
  "main": "./dist/index.js",
  "bin": {
    "mindoodb-bridge": "./dist/index.js",
    "mindoodb-bridge-provision": "./dist/provision.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "provision": "tsx src/provision.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "node scripts/e2e/server-sync.mjs"
  },
  "dependencies": {
    "mindoodb": ">=0.0.86 <0.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  }
}
